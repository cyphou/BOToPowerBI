{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-to-powerbi:schema:webi-document-snapshot:1.0",
  "title": "Read-only WebI document metadata snapshot",
  "description": "A local CMS API capture. Provider query metadata is optional. Report-to-provider links, SQL execution, source completeness and authenticated provenance are not established.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "reports", "data_providers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"$ref": "#/$defs/identifier"},
    "reports": {
      "type": "array",
      "items": {"$ref": "#/$defs/report"}
    },
    "data_providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataProvider"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "apiRecord": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "anyOf": [
            {"type": "string"},
            {"type": "integer"}
          ]
        }
      },
      "additionalProperties": true
    },
    "report": {
      "type": "object",
      "required": ["summary", "details", "elements"],
      "properties": {
        "summary": {"$ref": "#/$defs/apiRecord"},
        "details": {"$ref": "#/$defs/apiRecord"},
        "elements": {
          "type": "array",
          "items": {"$ref": "#/$defs/apiRecord"}
        }
      },
      "additionalProperties": false
    },
    "dataProvider": {
      "type": "object",
      "required": ["summary", "details"],
      "properties": {
        "summary": {"$ref": "#/$defs/apiRecord"},
        "details": {"$ref": "#/$defs/apiRecord"},
        "query_plan": {"$ref": "#/$defs/queryPlan"},
        "query_specification_xml": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {
        "query_plan": ["query_specification_xml"],
        "query_specification_xml": ["query_plan"]
      },
      "additionalProperties": false
    },
    "queryPlan": {
      "type": "object",
      "required": [
        "document_id", "provider_id", "status", "xml", "statements",
        "single_statement"
      ],
      "properties": {
        "document_id": {"$ref": "#/$defs/identifier"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["available", "empty"]},
        "xml": {"type": "string", "minLength": 1},
        "statements": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        },
        "single_statement": {"type": "boolean"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "empty"}}, "required": ["status"]},
          "then": {
            "properties": {
              "statements": {"type": "array", "maxItems": 0},
              "single_statement": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "available"}}, "required": ["status"]},
          "then": {"properties": {"statements": {"type": "array", "minItems": 1}}}
        },
        {
          "if": {"properties": {"single_statement": {"const": true}}, "required": ["single_statement"]},
          "then": {
            "properties": {
              "status": {"const": "available"},
              "statements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "operators": {"type": "array", "maxItems": 0}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "statement": {
      "type": "object",
      "required": ["index", "sql", "operators"],
      "properties": {
        "index": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "sql": {"type": "string", "pattern": "\\S"},
        "operators": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
