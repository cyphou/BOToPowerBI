{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-to-powerbi:schema:webi-query-plan:1.0",
  "title": "Saved WebI data-provider query plan",
  "description": "A locally saved API response. Identity and query provenance are declarations, not authenticated evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "provider_id", "status", "xml", "statements", "single_statement"],
  "properties": {
    "document_id": {"$ref": "#/$defs/identifier"},
    "provider_id": {"$ref": "#/$defs/identifier"},
    "status": {"enum": ["available", "empty"]},
    "xml": {"type": "string", "minLength": 1},
    "statements": {
      "type": "array",
      "items": {"$ref": "#/$defs/statement"}
    },
    "single_statement": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "empty"}}, "required": ["status"]},
      "then": {
        "properties": {
          "statements": {"type": "array", "maxItems": 0},
          "single_statement": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "available"}}, "required": ["status"]},
      "then": {"properties": {"statements": {"type": "array", "minItems": 1}}}
    },
    {
      "if": {"properties": {"single_statement": {"const": true}}, "required": ["single_statement"]},
      "then": {
        "properties": {
          "status": {"const": "available"},
          "statements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {"operators": {"type": "array", "maxItems": 0}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "anyOf": [
          {"enum": [".", ".."]},
          {"pattern": "[/\\\\\\u0000-\\u001f\\u007f]"}
        ]
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "sql", "operators"],
      "properties": {
        "index": {"type": ["string", "null"]},
        "sql": {"type": "string", "pattern": "\\S"},
        "operators": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
