{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-to-powerbi:schema:sap-bw-conversion-plan:1.0",
  "title": "Normalized SAP BW transformation to Fabric notebook",
  "description": "A declaration, not an SAP metadata format, ABAP parser or proof of equivalence. Cross-object lineage and decimal precision are validated by the generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "inventory_run_id", "source_object_id", "transformation_object_id",
    "dtp_object_id", "target_object_id", "definition_reference", "definition_sha256",
    "source_table", "target_table", "source_snapshot_id", "source_snapshot_cutoff_utc",
    "expected_rows", "rule_coverage", "input_columns", "rules"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "inventory_run_id": {"$ref": "#/$defs/text"},
    "source_object_id": {"$ref": "#/$defs/text"},
    "transformation_object_id": {"$ref": "#/$defs/text"},
    "dtp_object_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "target_object_id": {"$ref": "#/$defs/text"},
    "definition_reference": {"$ref": "#/$defs/text"},
    "definition_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_table": {"$ref": "#/$defs/table"},
    "target_table": {"$ref": "#/$defs/table"},
    "source_snapshot_id": {"$ref": "#/$defs/text"},
    "source_snapshot_cutoff_utc": {"type": "string", "format": "date-time"},
    "expected_rows": {"type": "integer", "minimum": 0},
    "rule_coverage": {"const": "complete"},
    "input_columns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "spark_type"],
        "properties": {"name": {"$ref": "#/$defs/text"}, "spark_type": {"$ref": "#/$defs/sparkType"}}
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {"oneOf": [{"$ref": "#/$defs/transfer"}, {"$ref": "#/$defs/constant"}, {"$ref": "#/$defs/decimalRule"}]}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "table": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"},
    "decimalType": {"type": "string", "pattern": "^decimal\\([1-9][0-9]?,[0-9]+\\)$"},
    "sparkType": {"type": "string", "pattern": "^(string|boolean|tinyint|smallint|int|bigint|float|double|date|timestamp|binary|decimal\\([1-9][0-9]?,[0-9]+\\))$"},
    "transfer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "target", "spark_type"],
      "properties": {
        "kind": {"const": "transfer"}, "source": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"}, "spark_type": {"$ref": "#/$defs/sparkType"},
        "source_rule_id": {"$ref": "#/$defs/text"}
      }
    },
    "constant": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "spark_type", "value"],
      "allOf": [{
        "if": {"properties": {"spark_type": {"$ref": "#/$defs/decimalType"}}, "required": ["spark_type"]},
        "then": {"properties": {"value": {"type": ["string", "null"]}}}
      }],
      "properties": {
        "kind": {"const": "constant"}, "target": {"$ref": "#/$defs/text"},
        "spark_type": {"anyOf": [{"enum": ["string", "boolean", "int", "bigint"]}, {"$ref": "#/$defs/decimalType"}]},
        "value": {"type": ["string", "boolean", "integer", "null"]},
        "source_rule_id": {"$ref": "#/$defs/text"}
      }
    },
    "decimalRule": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "left", "right", "target", "spark_type", "null_policy"],
      "properties": {
        "kind": {"enum": ["decimal_add", "decimal_subtract"]},
        "left": {"$ref": "#/$defs/text"}, "right": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"}, "spark_type": {"$ref": "#/$defs/sparkType"},
        "null_policy": {"const": "propagate"}, "source_rule_id": {"$ref": "#/$defs/text"}
      }
    }
  }
}
