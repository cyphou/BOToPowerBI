{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bo-to-powerbi:schema:sap-bw-bex-pbip-plan:1.6",
  "title": "Explicit SAP BW cube mapping to local PBIP",
  "description": "A manually authored connection and one-cube navigation declaration; optional BEx linkage checks local declarations only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "datasource"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5", "1.6"]},
    "project_name": {"$ref": "#/$defs/projectName"},
    "datasource": {"$ref": "#/$defs/datasource"},
    "bex_linkage": {"$ref": "#/$defs/bexLinkage"},
    "review_report": {"$ref": "#/$defs/reviewReport"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0"}},
        "required": ["schema_version"]
      },
      "then": {"not": {"required": ["bex_linkage"]}}
    },
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.2", "1.3", "1.4", "1.5", "1.6"]},
          "bex_linkage": {"type": "object"}
        },
        "required": ["schema_version", "bex_linkage"]
      },
      "then": {
        "properties": {
          "bex_linkage": {"required": ["dimension_bindings"]}
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"enum": ["1.0", "1.1", "1.2"]}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "datasource": {
            "properties": {
              "tables": {
                "items": {
                  "properties": {
                    "sap_bw_navigation": {
                      "properties": {
                        "dimensions": {
                          "items": {"not": {"required": ["properties"]}}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "datasource": {
            "properties": {
              "tables": {
                "items": {
                  "properties": {
                    "sap_bw_navigation": {"not": {"required": ["parameters"]}}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "datasource": {
            "properties": {
              "tables": {
                "items": {
                  "properties": {
                    "sap_bw_navigation": {
                      "properties": {
                        "parameters": {
                          "items": {"not": {"required": ["bex_variable_id"]}}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "datasource": {
            "properties": {
              "tables": {
                "items": {
                  "properties": {
                    "sap_bw_navigation": {
                      "required": ["parameters"],
                      "properties": {
                        "parameters": {
                          "contains": {"required": ["bex_variable_id"]}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": ["datasource"]
      },
      "then": {"required": ["bex_linkage"]}
    },
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5"]}
        },
        "required": ["schema_version"]
      },
      "then": {"not": {"required": ["review_report"]}}
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![cC][oO][nN](?:\\.|$)|[pP][rR][nN](?:\\.|$)|[aA][uU][xX](?:\\.|$)|[nN][uU][lL](?:\\.|$)|[cC][oO][mM][1-9](?:\\.|$)|[lL][pP][tT][1-9](?:\\.|$))[^\\s\\u0000-\\u001f\\u007f<>:\"/\\\\|?*.](?:[^\\u0000-\\u001f\\u007f<>:\"/\\\\|?*]*[^\\s\\u0000-\\u001f\\u007f<>:\"/\\\\|?*.])?$"
    },
    "server": {
      "allOf": [
        {"$ref": "#/$defs/text"},
        {"not": {"pattern": "(?:@|://)"}}
      ]
    },
    "reviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_name", "columns"],
      "properties": {
        "page_name": {"$ref": "#/$defs/text"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "connection", "tables"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "connection": {"$ref": "#/$defs/connection"},
        "tables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/cubeTable"}
        }
      }
    },
    "bexLinkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "provider_id", "cube_id", "key_figure_bindings"],
      "properties": {
        "query_id": {"$ref": "#/$defs/text"},
        "provider_id": {"$ref": "#/$defs/text"},
        "cube_id": {"$ref": "#/$defs/text"},
        "dimension_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/dimensionBinding"}
        },
        "key_figure_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/keyFigureBinding"}
        }
      }
    },
    "dimensionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "provider_dimension_name"],
      "properties": {
        "selector": {"$ref": "#/$defs/text"},
        "provider_dimension_name": {"$ref": "#/$defs/text"}
      }
    },
    "keyFigureBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_figure_id", "selector", "column"],
      "properties": {
        "key_figure_id": {"$ref": "#/$defs/text"},
        "selector": {"$ref": "#/$defs/text"},
        "column": {"$ref": "#/$defs/text"}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "server", "system_number", "client_id"],
      "properties": {
        "type": {"const": "sap_bw"},
        "server": {"$ref": "#/$defs/server"},
        "system_number": {"$ref": "#/$defs/text"},
        "client_id": {"$ref": "#/$defs/text"}
      }
    },
    "cubeTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns", "sap_bw_navigation"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/column"}
        },
        "sap_bw_navigation": {"$ref": "#/$defs/navigation"}
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "datatype"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "datatype": {"enum": ["string", "integer", "decimal", "boolean", "datetime"]}
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info_area", "cube_id", "dimensions", "measures"],
      "properties": {
        "info_area": {"$ref": "#/$defs/text"},
        "cube_id": {"$ref": "#/$defs/text"},
        "dimensions": {
          "type": "array",
          "items": {"$ref": "#/$defs/dimension"}
        },
        "measures": {
          "type": "array",
          "items": {"$ref": "#/$defs/measure"}
        },
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/cubeParameter"}
        }
      },
      "anyOf": [
        {"properties": {"dimensions": {"minItems": 1}}},
        {"properties": {"measures": {"minItems": 1}}}
      ]
    },
    "cubeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "arguments"],
      "properties": {
        "selector": {"$ref": "#/$defs/text"},
        "bex_variable_id": {"$ref": "#/$defs/text"},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/text"},
              {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/text"}
              }
            ]
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "attributes", "columns"],
      "properties": {
        "selector": {"$ref": "#/$defs/text"},
        "attributes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/dimensionProperty"}
        }
      }
    },
    "dimensionProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_column", "selector", "column"],
      "properties": {
        "source_column": {"$ref": "#/$defs/text"},
        "selector": {"$ref": "#/$defs/text"},
        "column": {"$ref": "#/$defs/text"}
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "column"],
      "properties": {
        "selector": {"$ref": "#/$defs/text"},
        "column": {"$ref": "#/$defs/text"}
      }
    }
  }
}
